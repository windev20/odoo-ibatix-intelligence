<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wizard_confirm_adresse_form" model="ir.ui.view">
        <field name="name">ibatix.wizard.confirm.adresse.form</field>
        <field name="model">ibatix.wizard.confirm.adresse</field>
        <field name="arch" type="xml">
            <form string="Mise à jour de la fiche client">
                <field name="partner_id" invisible="1"/>
                <group>
                    <div class="alert alert-info o_form_text" role="alert">
                        <h5>Informations extraites du document</h5>
                        <p>
                            <strong>Nom :</strong>
                            <field name="nom_extrait" readonly="1" nolabel="1" class="ms-1"/>
                        </p>
                        <p class="mb-0"><strong>Adresse :</strong></p>
                        <p class="ms-2 mb-0">
                            <field name="street2_extrait" readonly="1" nolabel="1"
                                   invisible="not street2_extrait"/>
                        </p>
                        <p class="ms-2 mb-0">
                            <field name="street_extrait" readonly="1" nolabel="1"/>
                        </p>
                        <p class="ms-2">
                            <field name="zip_extrait" readonly="1" nolabel="1"/>
                            <field name="city_extrait" readonly="1" nolabel="1" class="ms-1"/>
                        </p>
                        <hr/>
                        <p class="mb-0">
                            <strong>Le client habite-t-il toujours à cette adresse ?</strong>
                        </p>
                    </div>
                </group>
                <footer>
                    <button name="action_oui"
                            string="Oui — Mettre à jour le nom et l'adresse"
                            type="object"
                            class="btn btn-primary"/>
                    <button name="action_non"
                            string="Non — Mettre à jour le nom uniquement"
                            type="object"
                            class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
